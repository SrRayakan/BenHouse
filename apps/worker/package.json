{
  "name": "@benhouse/worker",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @benhouse/config build && pnpm --filter @benhouse/database build && pnpm --filter @benhouse/storage build",
    "dev": "tsx src/index.ts",
    "prebuild": "pnpm --filter @benhouse/config build && pnpm --filter @benhouse/database build && pnpm --filter @benhouse/storage build",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src --exclude '**/*.integration.test.ts' --pool=vmThreads --maxWorkers=1",
    "test:integration": "node ../../packages/database/scripts/with-worker-test-database.mjs"
  },
  "dependencies": {
    "@benhouse/storage": "workspace:*",
    "@benhouse/config": "workspace:*",
    "@benhouse/database": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.21.0"
  }
}
