{
  "name": "@benhouse/api",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @benhouse/config build && pnpm --filter @benhouse/database build",
    "dev": "nest start --watch",
    "prebuild": "pnpm --filter @benhouse/config build && pnpm --filter @benhouse/database build",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src --exclude '**/*.integration.test.ts' --pool=vmThreads --maxWorkers=1",
    "test:integration": "node ../../packages/database/scripts/with-test-database.mjs vitest run --config vitest.integration.config.mts"
  },
  "dependencies": {
    "@benhouse/config": "workspace:*",
    "@benhouse/database": "workspace:*",
    "@nestjs/common": "^11.1.11",
    "@nestjs/core": "^11.1.11",
    "@nestjs/platform-express": "^11.1.11",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.11"
  }
}
