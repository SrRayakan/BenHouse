# Configuración local de A2. Copia este archivo como .env y usa valores locales.
# No incluir secretos reales ni valores de producción.
NODE_ENV=development
DATABASE_URL=postgresql://benhouse:change-me-local-only@localhost:5432/benhouse
TEST_DATABASE_URL=postgresql://benhouse:change-me-local-only@localhost:5432/benhouse_test
# Hosts permitidos exclusivamente para tests con escritura. En CI deben ser hosts de test dedicados.
TEST_DATABASE_ALLOWED_HOSTS=localhost,127.0.0.1,::1
API_PORT=3001
APP_ORIGIN=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# B1.2 Identity Auth Core. Valores ficticios solo para desarrollo local.
SESSION_COOKIE_NAME=benhouse-local-session
SESSION_ABSOLUTE_TTL_SECONDS=2592000
SESSION_IDLE_TTL_SECONDS=86400
SESSION_LAST_SEEN_WRITE_INTERVAL_SECONDS=300
SESSION_TOKEN_KEYS=1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
SESSION_TOKEN_CURRENT_KEY_VERSION=1
CSRF_KEYS=1:AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE
CSRF_CURRENT_KEY_VERSION=1
ACCOUNT_TOKEN_KEYS=1:AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI
ACCOUNT_TOKEN_CURRENT_KEY_VERSION=1
AUTH_RATE_LIMIT_PEPPER_KEYS=1:AwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwM
AUTH_RATE_LIMIT_CURRENT_PEPPER_VERSION=1
EMAIL_VERIFICATION_TTL_SECONDS=86400
# Parámetros de desarrollo configurables; producción requiere benchmark previo.
ARGON2_MEMORY_KIB=19456
ARGON2_PASSES=2
ARGON2_PARALLELISM=2
TRUST_PROXY_HOPS=0
# Formato: límite:intérvalo_en_segundos:bloqueo_en_segundos
AUTH_RATE_LIMIT_REGISTER_EMAIL=5:900:900
AUTH_RATE_LIMIT_REGISTER_IP=20:900:900
AUTH_RATE_LIMIT_REGISTER_EMAIL_IP=5:900:900
AUTH_RATE_LIMIT_LOGIN_EMAIL=5:900:900
AUTH_RATE_LIMIT_LOGIN_IP=30:900:900
AUTH_RATE_LIMIT_LOGIN_EMAIL_IP=5:900:900
AUTH_RATE_LIMIT_VERIFY_EMAIL_TOKEN=5:900:900
AUTH_RATE_LIMIT_VERIFY_EMAIL_IP=30:900:900
AUTH_RATE_LIMIT_VERIFY_EMAIL_TOKEN_IP=5:900:900
AUTH_RATE_LIMIT_SESSION_READ_IP=120:60:60
AUTH_RATE_LIMIT_CLEANUP_INTERVAL_SECONDS=300
AUTH_RATE_LIMIT_CLEANUP_BATCH_SIZE=500

# Solo para PostgreSQL/PostGIS local mediante Docker Compose.
POSTGRES_DB=benhouse
POSTGRES_USER=benhouse
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
