# Configuración local de A2. Copia este archivo como .env y usa valores locales.
# No incluir secretos reales ni valores de producción.
NODE_ENV=development
DATABASE_URL=postgresql://benhouse:change-me-local-only@localhost:5432/benhouse
TEST_DATABASE_URL=postgresql://benhouse:change-me-local-only@localhost:5432/benhouse_test
API_PORT=3001
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Solo para PostgreSQL/PostGIS local mediante Docker Compose.
POSTGRES_DB=benhouse
POSTGRES_USER=benhouse
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
